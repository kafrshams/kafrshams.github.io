    progressBox.style.display = 'block';
    progressBar.style.width = percent + '%';
    progressText.textContent = text;
}

// تصغير الصورة قبل الرفع (أقصى بعد 1920 بكسل) لتبقى أقل من 10MB
function compressImage(file, maxSide = 1920, quality = 0.85) {
    return new Promise((resolve) => {
        const img = new Image();
        const objectUrl = URL.createObjectURL(file);
        img.onload = () => {
            const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
            const width = Math.round(img.width * scale);
            const height = Math.round(img.height * scale);
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            canvas.getContext('2d').drawImage(img, 0, 0, width, height);
            canvas.toBlob((blob) => {
                URL.revokeObjectURL(objectUrl);
                resolve(blob && blob.size < file.size ? blob : file);
            }, 'image/jpeg', quality);
        };
        img.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(file);
        };
        img.src = objectUrl;
    });
}

// رفع ملف إلى Cloudinary مع تقدّم الرفع
function uploadToCloudinary(file, resourceType, onProgress) {
    return new Promise((resolve, reject) => {
        const data = new FormData();
        data.append('file', file);
        data.append('upload_preset', UPLOAD_PRESET);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', `https://api.cloudinary.com/v1_1/${CLOUD_NAME}/${resourceType}/upload`);
        xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) onProgress(e.loaded / e.total);
        };
        xhr.onload = () => {
            try {
                const res = JSON.parse(xhr.responseText);
                if (xhr.status >= 200 && xhr.status < 300 && res.secure_url) {
                    resolve(res.secure_url);
                } else {
                    reject(new Error((res.error && res.error.message) || 'فشل رفع الملف'));
                }
            } catch (err) {
                reject(new Error('فشل رفع الملف'));
            }
        };
        xhr.onerror = () => reject(new Error('انقطع الاتصال أثناء رفع الملف'));
        xhr.send(data);
    });
}

contactForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    // حماية من البوتات: الحقل المخفي أو الإرسال السريع جدًا
    if (document.getElementById('website').value) return;
    if ((Date.now() - pageLoadedAt) / 1000 < MIN_FILL_SECONDS) {
        alert('يرجى المحاولة مرة أخرى بعد لحظات.');
        return;
    }

    const images = Array.from(document.getElementById('images').files);
    const video = document.getElementById('video').files[0];

    // التحقق من الملفات
    if (images.length > MAX_IMAGES) {
        alert(`الحد الأقصى ${MAX_IMAGES} صور.`);
        return;
    }
    if (images.some(f => !f.type.startsWith('image/'))) {
        alert('خانة الصور تقبل الصور فقط.');
        return;
    }
    if (video) {
        if (!video.type.startsWith('video/')) {
            alert('خانة الفيديو تقبل ملفات الفيديو فقط.');
            return;
        }
        if (video.size > MAX_VIDEO_MB * 1024 * 1024) {
            alert(`حجم الفيديو أكبر من ${MAX_VIDEO_MB} ميغابايت. للفيديوهات الأطول أرسلها لنا عبر واتساب.`);
            return;
        }
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'جاري الإرسال...';

    try {
        const imageUrls = [];
        const totalSteps = images.length + (video ? 1 : 0);
        let doneSteps = 0;

        for (let i = 0; i < images.length; i++) {
            const label = `جاري رفع الصورة ${i + 1} من ${images.length}...`;
            setProgress(Math.round((doneSteps / totalSteps) * 100), label);
            const compressed = await compressImage(images[i]);
            const url = await uploadToCloudinary(compressed, 'image', (p) => {
                setProgress(Math.round(((doneSteps + p) / totalSteps) * 100), label);
            });
            imageUrls.push(url);
            doneSteps++;
        }

        let videoUrl = '';
        if (video) {
            const label = 'جاري رفع الفيديو (قد يستغرق دقيقة)...';
            setProgress(Math.round((doneSteps / totalSteps) * 100), label);
            videoUrl = await uploadToCloudinary(video, 'video', (p) => {
                setProgress(Math.round(((doneSteps + p) / totalSteps) * 100), label);
            });
        }

        setProgress(100, 'جاري إرسال الإعلان...');

        // نرسل نصًا وروابط فقط إلى Make (بدون ملفات)
        const payload = new FormData();
        payload.append('name', document.getElementById('name').value);
        payload.append('phone', document.getElementById('phone').value);
        payload.append('serviceType', document.getElementById('serviceType').value);
        payload.append('message', document.getElementById('message').value);
        payload.append('images', imageUrls.join(','));
        payload.append('video', videoUrl);

        const response = await fetch(WEBHOOK_URL, { method: 'POST', body: payload });
        if (!response.ok) throw new Error('تعذر إرسال الإعلان، حاول مرة أخرى.');

        alertsSuccess.style.display = 'block';
        alertsSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        contactForm.reset();
        setTimeout(() => { alertsSuccess.style.display = 'none'; }, 6000);
    } catch (error) {
        console.error('Error:', error);
        alert(error.message || 'حدث خطأ أثناء الإرسال، يرجى المحاولة مرة أخرى.');
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'إرسال الإعلان الآن';
        progressBox.style.display = 'none';
        progressBar.style.width = '0';
    }
});
